# ============================================================
# Jellyfin Reel Sort — Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ============================================================

# Your user's numeric ID — run: id -u mariofishy
PUID=1000

# Your user's group ID — run: id -g mariofishy
PGID=1000

# Your timezone — see: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=America/Chicago

# ── Paths (override if your layout differs from the default) ──

# Jellyfin config/database directory on the host
JELLYFIN_CONFIG=/home/mariofishy/Jellyfin/config

# Jellyfin cache directory on the host (safe to delete, will regenerate)
JELLYFIN_CACHE=/home/mariofishy/Jellyfin/cache

# Root of your organized media library.
# This must be on the SAME filesystem partition as JELLYFIN_DOWNLOADS
# so that hardlinks created by sorter.py are preserved.
MEDIA_DIR=/home/mariofishy/media
