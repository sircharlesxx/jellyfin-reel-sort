# ============================================================
# Jellyfin Reel Sort — Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ============================================================

# Your user's numeric ID — run: id -u mariofishy
# Use 0 if your media directories are owned by root (cron runs as root)
PUID=0

# Your user's group ID — run: id -g mariofishy
# Use 0 if your media directories are owned by root (cron runs as root)
PGID=0

# Numeric GID of the host "render" group — needed for Intel QuickSync access.
# Docker resolves group_add by looking in the CONTAINER's /etc/group (not the host's),
# so the name "render" won't work — you must use the number.
# Find it with: grep render /etc/group   (e.g. "render:x:105:" → RENDER_GID=105)
RENDER_GID=105

# Your timezone — see: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=America/Chicago

# ── Paths ────────────────────────────────────────────────────────────────────
#
# IMPORTANT — use the REAL filesystem path, not a symlink.
# Docker cannot resolve symlinks when creating bind mounts.
#
# On many NAS devices (UGREEN, Synology, QNAP, etc.), /home/username is a
# symlink to the actual volume path (e.g. /volume1/home/username).
# Docker will fail with "operation not permitted" if you use the symlinked path.
# Find your real path with: readlink -f /home/mariofishy
#
# Wrong:   /home/mariofishy/media          (symlink — Docker will reject it)
# Correct: /volume1/home/mariofishy/media  (real path — Docker accepts it)

# Jellyfin config/database directory on the host (real path, not symlink)
JELLYFIN_CONFIG=/volume1/home/mariofishy/Jellyfin/config

# Jellyfin cache directory on the host (safe to delete, will regenerate)
JELLYFIN_CACHE=/volume1/home/mariofishy/Jellyfin/cache

# Root of your organized media library (real path, not symlink).
# Must be on the SAME filesystem partition as your downloads directory
# so that hardlinks created by sorter.py are preserved.
MEDIA_DIR=/volume1/home/mariofishy/media
